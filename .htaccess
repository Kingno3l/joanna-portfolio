# ==============================================================================
# JOANNA OLAYEMI STEPHEN PORTFOLIO - SERVER SECURITY & DEFENSES
# ==============================================================================

# ------------------------------------------------------------------------------
# SECURITY GUARD 2: Block Direct Browser Access to Sensitive Files
# ------------------------------------------------------------------------------
<FilesMatch "^(config\.php|config\.example\.php|\.env|\.gitignore|\.git|.*\.log|.*\.docx|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# Prevent Directory Browsing (Prevents listing folder contents)
# ------------------------------------------------------------------------------
Options -Indexes

# ------------------------------------------------------------------------------
# Security HTTP Response Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

# ------------------------------------------------------------------------------
# Enforce UTF-8 Character Encoding
# ------------------------------------------------------------------------------
AddDefaultCharset UTF-8

# ------------------------------------------------------------------------------
# Static Asset Caching for Fast Performance
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
